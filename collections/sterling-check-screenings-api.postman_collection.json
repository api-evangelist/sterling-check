              "raw": "{\n  \"candidateId\": \"<string>\",\n  \"packageId\": \"<string>\",\n  \"clientReferenceId\": \"<string>\",\n  \"callbackUri\": \"<uri>\",\n  \"invite\": {\n    \"method\": \"<string>\"\n  },\n  \"recurring\": {\n    \"enabled\": \"<boolean>\",\n    \"interval\": \"<string>\"\n  }\n}",
